DB_HOST=localhost
DB_NAME=jobmington_db
DB_USER=jobmington_user
DB_PASS=change_me

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://your-domain.com/jobmington/payments/verify.php
PAYSTACK_WEBHOOK_URL=https://your-domain.com/jobmington/api/webhooks/paystack.php

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

JOB_SCRAPER_LIMIT=80
JOB_SCRAPER_USER_AGENT=JobmingtonBot/1.0 (+https://your-domain.com/contact)

# Adzuna aggregator (optional). Free key: https://developer.adzuna.com
# Leave blank to skip the adzuna source. ADZUNA_COUNTRIES = comma-separated
# Adzuna country codes queried for remote roles (e.g. za,gb).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=za,gb

# The Muse (key optional but recommended): https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# Jooble search engine (covers Nigeria): https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=remote
JOOBLE_LOCATION=

# TheirStack — LinkedIn/Indeed/Glassdoor + 16 sites: https://theirstack.com/en/api
THEIRSTACK_API_KEY=
THEIRSTACK_MAX_AGE_DAYS=7

# Fantastic.jobs via RapidAPI (Active Jobs DB): https://rapidapi.com
FANTASTICJOBS_RAPIDAPI_KEY=
FANTASTICJOBS_RAPIDAPI_HOST=active-jobs-db.p.rapidapi.com

# Careerjet aggregator (affiliate id): https://www.careerjet.com/partners/api/
CAREERJET_AFFID=
# One request per country, comma separated. This is the only source that
# carries locally advertised work, and Careerjet picks the market from the
# location, so a single global call returns one country and no others.
CAREERJET_LOCATIONS=Nigeria,Kenya,Ghana,South Africa
# Leave empty. Setting a keyword filters the local supply away: asking Nigeria
# for "remote" turns 6,543 listings into 508.
CAREERJET_KEYWORDS=
# Careerjet reads the caller's address to decide which market answers, so it
# has to be the server's real one rather than a loopback address.
JOB_SCRAPER_PUBLIC_IP=

# ── Advertising ───────────────────────────────────────────────────────────────
# Meta (Facebook) pixel id, digits only, from Events Manager > Data Sources.
# Leave blank to switch the pixel off site-wide. Admins are never tracked.
FB_PIXEL_ID=
